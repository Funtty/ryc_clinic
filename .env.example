# ── RYC Dental Service ───────────────────────────────────────────────
# Template — copy to .env and fill in real values. NEVER commit .env.

# Public origin used for canonical URLs, sitemap and social cards. Set this to
# your production domain (no trailing slash), e.g. https://ryc-dental.com.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# SQLite for local dev. For production use PostgreSQL, e.g.:
#   postgresql://user:password@host:5432/ryc_dental?schema=public
# and set provider = "postgresql" in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# ≥32 random characters in production. Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret-32+chars"

# Admin account created by `npm run db:seed`. Log in with the username or email.
ADMIN_EMAIL="admin@your-clinic-domain.com"
ADMIN_USERNAME="funtty"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Receptionist account created by `npm run db:seed` (dev only).
STAFF_EMAIL="staff@your-clinic-domain.com"
STAFF_PASSWORD="replace-with-a-strong-password"

NODE_ENV="development"

# Payments. Providers:
#   simulate      - dev/test sandbox that just echoes statuses (never in prod)
#   paystack      - live Paystack hosted checkout (needs PAYSTACK_SECRET_KEY)
#   bank_transfer - clinic bank account; patient claims a transfer, the admin
#                   checks the bank and confirms payment manually (no gateway)
PAYMENT_PROVIDER="bank_transfer"

# bank_transfer provider: the exact account shown to patients at checkout.
BANK_ACCOUNT_NAME="RYC Dental Service"
BANK_ACCOUNT_NUMBER="0123456789"
BANK_NAME="GTBank"

# Live Paystack adapter (used only when PAYMENT_PROVIDER="paystack").
PAYSTACK_SECRET_KEY=""

# Clinic alert emails (Resend). Sent to the clinic's own inbox when a patient
# books an appointment or a payment is made/confirmed. Leave empty to disable.
RESEND_API_KEY=""
EMAIL_FROM="RYC Dental Service <onboarding@resend.dev>"
CLINIC_NOTIFY_EMAIL="ryc@your-clinic-domain.com"